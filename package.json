{
  "name": "deadlock-counter-advisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "data:pull": "node scripts/pull-game-data.mjs",
    "data:verify": "node scripts/verify-game-data.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run data:verify && npm run research:verify && npm run test && npm run build",
    "research:build": "node scripts/build-research.mjs",
    "research:verify": "node scripts/build-research.mjs --verify"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
